# Per-developer secrets for the Paladala Portal reporter.
# The .example is committed; the real xcconfigs are not.
ios/Paladala/Config/Opspad.Debug.xcconfig
ios/Paladala/Config/Opspad.Release.xcconfig
# Per-version release notes for the AltSource
# manifest. Written by the iOS CI on every build (see
# .github/workflows/ios-unsigned-ipa.yml "Extract clean
# release notes for AltSource"); the apps.json generator
# reads them back to backfill per-version
# localizedDescription. The directory and the files
# inside it are intentional git content, not docs.
!release-notes/
!release-notes/*.md
.omx/
