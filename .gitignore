local.properties

# 🔥 忽略所有 build 目录
**/build/

# 🔥 忽略 Kotlin 编译器临时文件和错误日志
*.compiler.options
.kotlin/
*.log

# 🔥 忽略敏感配置文件
*.keystore
*.jks
google-services.json
# Firebase iOS SDK config — generated per-developer / per-target
# from the Firebase Console, never commit (otherwise the same
# project_id would leak across teammates + CI).
GoogleService-Info.plist
signing.properties
keystore.properties

# 🔥 忽略其他临时文件
*.tmp
*.bak
*.swp
*~

# 🔥 忽略 IDE 相关
.idea/
.vscode/
*.ipr
*.iws

# 🔥 忽略测试报告
/reports/

# 🔥 忽略 APK 和发布文件
*.apk
*.aab
**/release/
app/release/

# 🔥 忽略 AI/Agent 相关文件
.agent/
.agents/
.gemini/
.cursor/
.claude/
.worktrees/
*.ai.md
*.txt
bilipai_log_*.txt
skills-lock.json
!AI.txt
!llm.txt

# Node / npm（顶层 experimental 目录，不入仓）
node_modules/
/package.json
/package-lock.json

# Xcode workspace 用户态（contents.xcworkspacedata 与
# xcshareddata/IDEWorkspaceChecks.plist 仍需入库）
**/project.xcworkspace/xcuserdata/

# Bilibili API files
bilibili-API-collect/

